# Copy this file to .env for local development. Never commit .env or real secrets.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
# Replace the placeholder below with the generated value before running the app.
# With ZURI_ENV=production the app refuses to start if this is missing or a placeholder.
ZURI_HMAC_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTER_SECRET

# development (default) or production. Production enforces real secrets.
ZURI_ENV=development
# Number of your own reverse proxies (e.g. nginx) in front of the app; 0 = trust no X-Forwarded-For.
ZURI_TRUSTED_PROXIES=0

# Confirm the correct emergency number with local authorities for each deployment country.
ZURI_EMERGENCY_NUMBER=112
ZURI_AUDIT_LOG=logs/audit.jsonl
ZURI_SESSION_TTL=1800
ZURI_KB_MIN_SCORE=0.25
ZURI_RATE_LIMIT=30
# Trained classifier: probability above which an AI caution note is added (it never changes the rules decision)
ZURI_MODEL_THRESHOLD=0.85
# 90-day execution tracks (pseudonymous ids, start date, weekly check-ins only)
ZURI_TRACKS_DB=var/tracks.sqlite3

# Hand-off to Zuri Circle licensed health professionals
# Number/WhatsApp shown to users who ask to talk to someone:
ZURI_TELEHEALTH_CONTACT=
# HTTPS endpoint that receives call-back tickets (no message text; phone only with consent):
ZURI_HANDOFF_WEBHOOK=
# Bearer token for /api/insights (anonymized indicators). Leave empty to disable the endpoint.
ZURI_ADMIN_TOKEN=

# WhatsApp Business Cloud API. Leave empty for local dry-run testing.
# Do not commit live tokens or app secrets.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
